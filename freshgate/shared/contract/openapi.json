      "post": {
        "summary": "Prompt volatility classification"
      }
    },
    "/v1/extract": {
      "post": {
        "summary": "Claim extraction"
      }
    },
    "/v1/verify": {
      "post": {
        "summary": "Synchronous verification"
      }
    },
    "/v1/verify/async": {
